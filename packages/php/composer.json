{
    "name": "kampe/telegram-2fa",
    "description": "Telegram as a second authentication factor. Framework-agnostic core with a Laravel adapter.",
    "keywords": ["telegram", "2fa", "mfa", "two-factor", "authentication", "otp", "kampe"],
    "homepage": "https://github.com/getkampe/telegram-2fa",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Joseph Uruetse",
            "email": "support@getkampe.com",
            "role": "Author"
        }
    ],
    "support": {
        "issues": "https://github.com/getkampe/telegram-2fa/issues",
        "source": "https://github.com/getkampe/telegram-2fa"
    },
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "illuminate/cache": "^12.70",
        "illuminate/contracts": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "phpunit/phpunit": "^10.5"
    },
    "suggest": {
        "ext-curl": "Used by the default HttpTelegramClient. Any PSR-18 client can be substituted."
    },
    "autoload": {
        "psr-4": {
            "Kampe\\TelegramTwoFactor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kampe\\TelegramTwoFactor\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kampe\\TelegramTwoFactor\\Laravel\\TelegramTwoFactorServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
