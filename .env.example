# Telegram 2FA — environment
#
# Copy to .env and fill in. Use a SEPARATE BOT per environment: a webhook is
# registered per bot token, last writer wins, so staging pointing at the
# production bot silently takes over its updates.

# From @BotFather. This is a credential: it can read every message sent to the
# bot and send as the bot. Never commit it; /revoke it if you ever do.
TELEGRAM_BOT_TOKEN=

# Without the @. Needed to build t.me deeplinks; without it, linking falls back
# to the paste flow.
TELEGRAM_BOT_USERNAME=

# 32-256 characters of A-Za-z0-9_- . Telegram returns this in the
# X-Telegram-Bot-Api-Secret-Token header on every webhook request, and the
# library rejects any request where it does not match.
#
# This is what stops a stranger forging updates and asking your bot to mint a
# 2FA code for someone else's account. The library refuses to start without it.
#
#   php artisan telegram:webhook --generate-secret
#   node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
TELEGRAM_WEBHOOK_SECRET=

# REQUIRED, 32+ characters. This is the HMAC key for code hashes, and it is the
# part that does the work: a six-digit code has only a million possible values,
# so an unkeyed digest of one is reversed by a table anyone can build in
# seconds. Without this key, hashing the codes protects nothing from whoever
# reads the cache.
#
# Keep it somewhere other than the cache it protects. Changing it invalidates
# codes in flight, which is harmless. Both packages refuse to start without it.
#
#   php artisan telegram:webhook --generate-secret     (same generator)
TELEGRAM_2FA_HASH_PEPPER=

# Optional ------------------------------------------------------------------

# Must be redis or memcached. Two requirements, and the second is not a
# preference: the store has to be shared across processes (on `array` or `file`
# a code issued by one request can be invisible to the next), and it has to
# provide real atomic get-and-delete and set-if-absent operations. Without
# those, two simultaneous verifications of one code can both succeed and the
# attempt limit can be beaten by racing it. `database` and `file` do not
# provide them.
TELEGRAM_2FA_CACHE_STORE=redis

# Shown in bot messages. Defaults to your application name.
TELEGRAM_2FA_APP_NAME=

# Protocol tuning. The defaults are the recommended values and the library
# enforces the bounds; these are here to be read, not usually changed.
# TELEGRAM_2FA_CODE_TTL=300        # 30-600 seconds
# TELEGRAM_2FA_COOLDOWN=120        # >= 30 seconds between sends
# TELEGRAM_2FA_MAX_ATTEMPTS=5      # 1-10 guesses per code
